{
  "name": "canes-analytics",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless",
    "cypress:clean": "npx rimraf cypress/reports cypress/screenshots",
    "cypress:report": "node scripts/generate-report.mjs",
    "cypress:full": "node scripts/cypress-full.mjs",
    "cypress:visual:baseline": "cypress run --spec cypress/e2e/visual-regression.cy.js --expose visualRegressionType=base",
    "cypress:visual": "cypress run --spec cypress/e2e/visual-regression.cy.js",
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.30.0",
    "posthog-js": "^1.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "cypress": "^15.20.1",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-visual-regression": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
