{
  "name": "canes-analytics",
  "private": true,
  "version": "1.2.8",
  "type": "module",
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ios:version": "node scripts/ios-version.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless",
    "cypress:clean": "npx rimraf cypress/reports cypress/screenshots",
    "cypress:report": "node scripts/generate-report.mjs",
    "cypress:full": "node scripts/cypress-full.mjs",
    "cypress:visual:baseline": "cypress run --spec cypress/e2e/visual-regression.cy.js --expose visualRegressionType=base",
    "cypress:visual": "cypress run --spec cypress/e2e/visual-regression.cy.js",
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/supabase-js": "^2.116.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "posthog-js": "^1.434.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hockey-rink": "^0.2.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-visual-regression": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
