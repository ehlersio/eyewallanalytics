{
  "name": "canes-analytics",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless",
    "cypress:clean": "npx rimraf cypress/reports cypress/screenshots",
    "cypress:report": "node scripts/generate-report.mjs",
    "cypress:full": "node scripts/cypress-full.mjs",
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.383.0",
    "posthog-js": "^1.387.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "cypress": "^15.17.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
